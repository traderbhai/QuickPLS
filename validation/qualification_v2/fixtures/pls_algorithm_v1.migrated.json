  "scientific_contract": {
    "estimands": [
      {
        "id": "composite_solution",
        "label": "Composite measurement solution",
        "definition": "Converged PLS construct scores, outer weights, outer loadings, and the score subspace for the declared weighting scheme and orientation convention.",
        "unit": "standardized coefficient or score",
        "output_ids": [
          "outer_weights",
          "outer_loadings",
          "construct_scores",
          "construct_score_subspace"
        ]
      },
      {
        "id": "structural_solution",
        "label": "Structural model solution",
        "definition": "Standardized direct paths, total effects, and endogenous construct explained variance computed from the converged composite scores.",
        "unit": "standardized coefficient or proportion",
        "output_ids": [
          "path_coefficients",
          "effects_matrix",
          "r_squared"
        ]
      },
      {
        "id": "optimization_status",
        "label": "Iteration termination status",
        "definition": "Deterministic convergence classification under the declared tolerance and maximum-iteration policy.",
        "unit": "categorical status",
        "output_ids": [
          "convergence_status"
        ]
      },
      {
        "id": "recovery_quality",
        "label": "Monte Carlo recovery quality",
        "definition": "Across retained and failed fits, the proportion of simulated populations for which the declared recovery criterion is satisfied.",
        "unit": "proportion",
        "output_ids": [
          "recovery_coverage"
        ]
      }
    ],
    "preprocessing": [
      {
        "id": "missing_value_policy",
        "order": 0,
        "operation": "Apply the declared row-wise missing-value policy before any moments are computed.",
        "parameters": {
          "default": "listwise",
          "empty_after_filter": "error"
        },
        "applies_to": [
          "raw_numeric_rows"
        ]
      },
      {
        "id": "sample_standardization",
        "order": 1,
        "operation": "Center each indicator and scale by the sample standard deviation with denominator n minus one.",
        "parameters": {
          "ddof": 1,
          "zero_variance": "error"
        },
        "applies_to": [
          "retained_numeric_rows"
        ]
      },
      {
        "id": "deterministic_orientation",
        "order": 2,
        "operation": "Orient each construct so the deterministic anchor indicator has a non-negative loading.",
        "parameters": {
          "anchor": "first_declared_nonzero_loading",
          "tie_break": "indicator_id"
        },
        "applies_to": [
          "outer_weights",
          "outer_loadings",
          "construct_scores"
        ]
      }
    ],
    "model_predicates": [
      {
        "id": "recursive_inner_model",
        "expression": "The directed structural graph is acyclic and every edge references two declared constructs.",
        "on_violation": "error",
        "diagnostic_code": "pls_model_cycle_or_unknown_construct"
      },
      {
        "id": "identified_measurement_blocks",
        "expression": "Every construct has at least one uniquely assigned indicator and a supported Mode A or Mode B block.",
        "on_violation": "error",
        "diagnostic_code": "pls_measurement_block_not_identified"
      }
    ],
    "data_predicates": [

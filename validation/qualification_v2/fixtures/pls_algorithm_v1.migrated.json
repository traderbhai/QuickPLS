  "comparison_contract": {
    "outputs": [
      {
        "output_id": "outer_weights",
        "rule": "sign_orientation",
        "rationale": "Weights are orientation-equivalent; tolerances cover floating-point accumulation differences between independent implementations.",
        "absolute_tolerance": 1e-08,
        "relative_tolerance": 1e-06,
        "orientation_keys": [
          "construct_id",
          "anchor_indicator_id"
        ]
      },
      {
        "output_id": "outer_loadings",
        "rule": "abs_relative",
        "rationale": "Loadings have a fixed declared orientation and are compared elementwise across values near and away from zero.",
        "absolute_tolerance": 1e-08,
        "relative_tolerance": 1e-06
      },
      {
        "output_id": "construct_scores",
        "rule": "sign_orientation",
        "rationale": "Composite scores are equivalent up to the frozen anchor orientation before numerical comparison.",
        "absolute_tolerance": 1e-08,
        "relative_tolerance": 1e-06,
        "orientation_keys": [
          "construct_id",
          "anchor_indicator_id"
        ]
      },
      {
        "output_id": "construct_score_subspace",
        "rule": "subspace",
        "rationale": "Near-degenerate score solutions can have non-unique bases while spanning the same scientifically relevant subspace.",
        "maximum_principal_angle_degrees": 0.1,
        "projector_tolerance": 1e-08
      },
      {
        "output_id": "path_coefficients",
        "rule": "abs_relative",
        "rationale": "Standardized paths require elementwise accuracy with absolute protection around zero and relative protection elsewhere.",
        "absolute_tolerance": 1e-08,
        "relative_tolerance": 1e-06
      },
      {
        "output_id": "effects_matrix",
        "rule": "matrix_norm",
        "rationale": "The effect matrix requires both a global Frobenius bound and an elementwise cap so localized errors cannot hide.",
        "absolute_tolerance": 1e-08,
        "relative_tolerance": 1e-06,
        "norm": "frobenius",
        "elementwise_tolerance": 1e-07
      },
      {
        "output_id": "r_squared",
        "rule": "abs_relative",
        "rationale": "Explained-variance proportions require tight absolute and relative agreement within their bounded scale.",
        "absolute_tolerance": 1e-09,
        "relative_tolerance": 1e-07
      },
      {
        "output_id": "convergence_status",
        "rule": "exact",
        "rationale": "Termination classifications and diagnostic labels are deterministic categorical contract outputs."
      },
      {
        "output_id": "recovery_coverage",
        "rule": "monte_carlo_interval",
        "rationale": "Recovery is a simulation proportion, so acceptance is governed by a predeclared confidence interval and precision bound.",
        "confidence_level": 0.95,
        "maximum_half_width": 0.02,
        "acceptance_interval": [
          0.9,
          1.0
        ]
      }
    ]
  },

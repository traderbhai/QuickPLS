  "comparison_contract": {
    "outputs": [
      {
        "output_id": "result_status",
        "rule": "exact",
        "rationale": "Typed availability and boundary states must match exactly."
      },
      {
        "output_id": "eligible_path_count",
        "rule": "exact",
        "rationale": "The eligible structural-path count is deterministic and integer-valued."
      },
      {
        "output_id": "significant_path_count",
        "rule": "exact",
        "rationale": "The selected two-sided threshold count is deterministic, including null and zero states."
      },
      {
        "output_id": "driver_source_id",
        "rule": "exact",
        "rationale": "Stable driver source identity must agree exactly after deterministic tie-breaking."
      },
      {
        "output_id": "driver_target_id",
        "rule": "exact",
        "rationale": "Stable driver target identity must agree exactly after deterministic tie-breaking."
      },
      {

  "scientific_contract": {
    "estimands": [
      {
        "id": "significance_aware_driver_selection",
        "label": "Significance-aware structural-path driver",
        "definition": "Match every finite structural path to one complete linked two-sided normal-reference PLS bootstrap probability, select probabilities at or below 0.05, and choose the smallest absolute significant coefficient with stable source-then-target tie-breaking; otherwise return the exact typed unavailable state.",
        "unit": "stable path identities, probability, coefficient magnitude, counts, and typed status",
        "output_ids": [
          "result_status",
          "eligible_path_count",
          "significant_path_count",
          "driver_source_id",
          "driver_target_id",
          "driver_p_value_two_sided",
          "minimum_absolute_path_coefficient"
        ]
      },
      {
        "id": "inverse_square_root_technical_requirement",
        "label": "Retrospective inverse-square-root technical requirement",
        "definition": "For a nonzero finite selected driver beta_min, report ceil((2.486 / abs(beta_min))^2), the linked complete-case analytical sample size, and whether the analytical sample meets the technical requirement without clamping, epsilon substitution, or prospective-power interpretation.",
        "unit": "observations and deterministic adequacy decision",
        "output_ids": [
          "technically_required_sample_size",
          "analytical_sample_size",
          "meets_technical_requirement"
        ]
      },
      {
        "id": "method_assumption_provenance",
        "label": "Formula and selection-test provenance",
        "definition": "Record separately the directional formula assumptions alpha 0.05 and power 0.80 from the two-sided bootstrap significance-selection source and threshold, together with the frozen selection rule.",
        "unit": "exact method identifiers and fixed scalar assumptions",
        "output_ids": [
          "formula_constant",
          "formula_alpha",
          "formula_power",
          "formula_test_direction",
          "selection_rule",
          "significance_source",
          "significance_alpha"
        ]
      }
    ],
    "preprocessing": [
      {
        "id": "linked_pls_analytical_sample",
        "order": 0,
        "operation": "Use the exact finite model-wide complete-case rows and structural path estimates produced by the linked PLS-SEM point estimator; never derive a new sample or substitute missing values with zero.",
        "parameters": {
          "missing_policy": "inherits_pls_listwise_deletion",
          "path_coefficients": "linked_point_estimate",
          "prospective_power": false
        },
        "applies_to": [
          "raw_numeric_pls_data",
          "linked_pls_point_result"
        ]
      },
      {
        "id": "exact_path_inference_identity_join",
        "order": 1,
        "operation": "Join each structural path to exactly one bootstrap path parameter by source and target stable IDs; reject missing, duplicate, foreign, nonfinite, or out-of-range probabilities as inference_incomplete.",
        "parameters": {
          "identity": "source,target",
          "probability_field": "p_value_two_sided",
          "probability_range": "[0,1]",
          "complete_join_required": true
        },
        "applies_to": [
          "linked_pls_bootstrap_when_present"
        ]
      },
      {
        "id": "significant_driver_selection",
        "order": 2,
        "operation": "Retain paths with two-sided normal-reference bootstrap p at or below 0.05, then order by absolute coefficient, source stable ID, and target stable ID.",
        "parameters": {
          "alternative": "two_sided",
          "alpha": 0.05,
          "tie_break": "absolute_coefficient,source_id,target_id"
        },
        "applies_to": [
          "complete_path_inference"
        ]
      },
      {
        "id": "inverse_square_root_calculation",
        "order": 3,
        "operation": "Apply the frozen directional inverse-square-root formula and ceiling only to the selected nonzero finite driver, preserving typed zero and supported-integer-range failures.",
        "parameters": {
          "constant": 2.486,
          "alpha": 0.05,
          "power": 0.8,
          "formula_test": "directional",
          "rounding": "ceiling",
          "maximum_exact_integer": 9007199254740991
        },
        "applies_to": [
          "selected_driver_path"
        ]
      }
    ],
    "model_predicates": [
      {
        "id": "pls_sem_result_only",
        "expression": "The result belongs to the PLS-SEM algorithm cell, uses one valid recursive PLS model, and does not treat prospective Monte Carlo power as this result.",
        "on_violation": "not_applicable",
        "diagnostic_code": "posthoc_sample_size.pls_sem_result_required"
      },
      {
        "id": "structural_path_identity_integrity",
        "expression": "Every structural path has nonempty unique source and target stable IDs and a finite coefficient; a model with no structural path receives the explicit not_applicable_no_structural_path state.",
        "on_violation": "error",
        "diagnostic_code": "posthoc_sample_size.invalid_structural_path_identity"
      },
      {
        "id": "optional_complete_bootstrap_link",
        "expression": "Point-only PLS returns inference_unavailable; a numeric technical requirement requires one complete linked current PLS bootstrap probability for every structural path.",
        "on_violation": "error",
        "diagnostic_code": "posthoc_sample_size.incomplete_bootstrap_link"
      }
    ],
    "data_predicates": [
      {
        "id": "raw_numeric_input_inherited",
        "expression": "Input is raw numeric row-level data accepted by the qualified PLS estimator; covariance and correlation matrices are rejected for this bounded cell.",
        "on_violation": "not_applicable",
        "diagnostic_code": "posthoc_sample_size.raw_rows_required"
      },
      {
        "id": "analytical_sample_binding",
        "expression": "The reported analytical sample size equals the linked estimator used_observations count after its declared missing-data treatment.",
        "on_violation": "error",
        "diagnostic_code": "posthoc_sample_size.analytical_sample_mismatch"
      },
      {
        "id": "finite_probability_and_integer_boundary",
        "expression": "All supplied selection probabilities are finite in [0,1], coefficients are finite, and a numeric requirement is emitted only within the exact JSON integer boundary.",
        "on_violation": "error",
        "diagnostic_code": "posthoc_sample_size.numeric_boundary"
      }
    ],

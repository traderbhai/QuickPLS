      "workflow_steps": ["setup", "invalid_setup_blocked", "execute", "inspect_results", "export", "save", "close", "reopen_same_run", "cleanup"],
      "viewports": ["1024x700", "1280x720", "1440x900"],
      "offline_required": true,
      "cancellation_required": false,
      "process_cleanup_required": true
    },
    "audit": {"exact_identity_fields": ["passed", "feature_id", "method_version", "catalogue_snapshot_date"], "source_hashes_required": true, "freshness_required": true, "reports_must_pass": true}
  },

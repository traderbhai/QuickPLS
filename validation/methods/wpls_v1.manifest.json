  "feature": {
    "id": "qpls3.pls.weighted",
    "label": "Weighted PLS Algorithm",
    "method_version": "wpls_case_weighted_v1",
    "method_kind": "deterministic",
    "catalogue_snapshot_date": "2026-08-12",
    "catalogue_url": "https://smartpls.com/documentation/algorithms-and-techniques/core-algorithm/weighted-pls/"
  },
  "claim": {
    "supported_scope": "Positive case-weighted reflective PLS with standardized preprocessing and path or factor inner weighting.",
    "estimand": "Case-weighted composite scores, outer weights and loadings, weighted least-squares structural paths, R-squared values, weight sum, and effective sample size under the persisted case weights.",
    "assumptions": [
      "The selected case-weight column is numeric, finite, and strictly positive for every retained complete observation.",
      "All constructs are reflective and the model is recursive with path or factor weighting.",
      "Weighted means, unbiased weighted variances, covariances, score normalization, and regressions use the same retained rows and weights."
    ],
    "exclusions": [
      "Survey-design weights, strata, clusters, finite-population corrections, and replicate-weight variance estimation are excluded.",
      "Formative blocks, PCA weighting, generated interactions, and higher-order constructs are excluded.",
      "Weighted bootstrap, permutation, jackknife, and publication-wide weighting recommendations are not qualified here."
    ],
    "warnings": [
      "Case weights change the estimand and must have a defensible study-specific interpretation.",
      "Effective sample size can be materially smaller than the number of retained observations."
    ]
  },
  "scientific_contract": {
    "equations": [
      {
        "id": "unbiased_weighted_covariance",
        "expression": "cov_w(x,y) = sum_i w_i (x_i-mu_x)(y_i-mu_y) / [sum_i w_i - sum_i w_i^2/sum_i w_i]",
        "variables": [
          "cov_w",
          "w_i",
          "x_i",
          "y_i",
          "mu_x",
          "mu_y"
        ],
        "source_reference_id": "westfall_weighted_moments"
      },
      {
        "id": "kish_effective_sample_size",
        "expression": "n_eff = (sum_i w_i)^2 / sum_i w_i^2",
        "variables": [
          "n_eff",
          "w_i"
        ],
        "source_reference_id": "kish_1965"
      }
    ],
    "references": [
      {
        "id": "kish_1965",
        "kind": "primary_paper",
        "citation": "Kish (1965), Survey Sampling, effective sample size under unequal weights",
        "locator": "docs/methods/PLS_WPLS_V1.md",
        "independence_group": "published_weighting_method",
        "runtime_policy": "no_runtime_dependency"
      },
      {
        "id": "westfall_weighted_moments",
        "kind": "published_fixture",
        "citation": "Published weighted-mean and unbiased weighted-covariance formula fixture",
        "locator": "docs/methods/PLS_WPLS_V1.md",
        "independence_group": "published_weighted_moments",
        "runtime_policy": "no_runtime_dependency"
      },
      {
        "id": "independent_python_wpls",
        "kind": "independent_python",
        "citation": "Independent Python implementation of weighted preprocessing, score iteration, paths, loadings, and R-squared",
        "locator": "validation/wpls_reference.py",
        "independence_group": "python_reference",
        "runtime_policy": "development_validation_only"
      }
    ],
    "simulations": [
      {
        "id": "weighted_parameter_recovery",
        "purpose": "recovery",
        "design": "Reflective recursive models under uniform, moderately unequal, and strongly unequal positive case weights with varied loadings and paths.",
        "seed_policy": "Frozen scenario-indexed seeds; QuickPLS and the independent reference receive identical observations and weights.",
        "metrics": [
          "path_error",
          "loading_error",
          "weighted_r2_error",
          "effective_sample_size_error",
          "convergence_rate"
        ],
        "acceptance_rule": "Supported scenarios meet the frozen reference tolerance, uniform weights reduce to ordinary PLS, and every invalid-weight case fails before estimation."
      }
    ],
    "boundaries": [
      {
        "id": "invalid_weight_values",
        "category": "data_pathology",
        "case": "A retained case weight is nonfinite, zero, or negative.",
        "expected_behavior": "Validation or execution rejects the dataset with no partial weighted result."
      },
      {
        "id": "missing_weight_listwise",
        "category": "data_pathology",
        "case": "A case-weight value is missing under the fixed listwise-deletion policy.",
        "expected_behavior": "The row is omitted before weighted estimation, and the analytical payload and weight metadata equal an otherwise identical dataset with that row removed."
      },
      {
        "id": "unsupported_weighted_shape",
        "category": "unsupported_scope",
        "case": "The recipe requests formative measurement, PCA weighting, generated constructs, or resampling with case weights.",
        "expected_behavior": "The typed recipe validator blocks execution and names the unsupported combination."
      },
      {
        "id": "uniform_weight_reduction",
        "category": "metamorphic",
        "case": "All valid case weights are multiplied by one positive constant or are set uniformly.",
        "expected_behavior": "Scaling weights leaves estimates unchanged and uniform weights reproduce ordinary PLS within tolerance."
      },
      {
        "id": "repeat_and_reorder",
        "category": "determinism",
        "case": "The same weighted data are executed repeatedly or rows are consistently reordered.",
        "expected_behavior": "Mapped analytical payloads remain equal within tolerance, with exact repeated-run arithmetic."
      },
      {
        "id": "weight_metadata_tamper",
        "category": "tamper",
        "case": "The saved weight column, sum, effective sample size, covariance convention, estimate, or method version is altered.",
        "expected_behavior": "Strict project validation rejects the archive rather than displaying the modified WPLS result."
      }
    ],
    "numerical_tolerance": 1e-06
  },

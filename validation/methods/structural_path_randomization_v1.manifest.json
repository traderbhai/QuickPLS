  "feature": {
    "id": "qpls3.inference.structural_path_randomization",
    "label": "Structural Path Randomization",
    "method_version": "freedman_lane_permutation_v1",
    "method_kind": "stochastic",
    "catalogue_snapshot_date": "2026-08-12",
    "catalogue_url": "https://smartpls.com/documentation/algorithms-and-techniques/"
  },
  "claim": {
    "supported_scope": "Single-model direct structural-path tests conditional on fixed original converged PLS construct scores, with exchangeable reduced-model residuals and deterministic two-sided plus-one probabilities.",
    "estimand": "Direct structural path coefficients conditional on the original fixed PLS construct scores.",
    "assumptions": [
      "The structural model is recursive and supported by the PLS-PM v1 estimator.",
      "Reduced-model residuals are exchangeable under the tested null.",
      "Current calibration covers paired homoscedastic Gaussian constant-variance scenarios."
    ],
    "exclusions": [
      "Measurement-model re-estimation within permutations is excluded.",
      "Heteroskedastic and broader non-Gaussian calibration claims are excluded.",
      "MGA, MICOM, multiplicity adjustment, mediation inference, and causal proof are excluded."
    ],
    "warnings": [
      "Probabilities are conditional and approximate under the documented exchangeability assumptions.",
      "Pathwise probabilities are unadjusted for multiplicity."
    ]
  },
  "scientific_contract": {
    "equations": [
      {
        "id": "plus_one_probability",
        "expression": "p = (1 + sum_b I(|beta_b| >= |beta_observed|)) / (B + 1)",
        "variables": ["p", "beta_b", "beta_observed", "B"],
        "source_reference_id": "freedman_lane_1983"
      },
      {
        "id": "freedman_lane_response",
        "expression": "y_b = fitted_reduced + permute(residual_reduced, pi_b)",
        "variables": ["y_b", "fitted_reduced", "residual_reduced", "pi_b"],
        "source_reference_id": "freedman_lane_1983"
      }
    ],
    "references": [
      {
        "id": "freedman_lane_1983",
        "kind": "primary_paper",
        "citation": "Freedman and Lane (1983), A Nonstochastic Interpretation of Reported Significance Levels",
        "locator": "https://doi.org/10.1080/01621459.1983.10477994",
        "independence_group": "primary_equations",
        "runtime_policy": "no_runtime_dependency"
      },
      {
        "id": "quickpls_independent_python_reference",
        "kind": "independent_python",
        "citation": "Independent Python fixed-score Freedman-Lane reference and frozen permutation plan",
        "locator": "validation/structural_path_randomization_reference.py",
        "independence_group": "python_reference",
        "runtime_policy": "development_validation_only"
      },
      {
        "id": "quickpls_independent_r_reference",
        "kind": "independent_r",
        "citation": "Independent R coefficient recomputation over the frozen permutation plan",
        "locator": "validation/structural_path_randomization_reference.R",
        "independence_group": "r_reference",
        "runtime_policy": "development_validation_only"
      }
    ],
    "simulations": [
      {
        "id": "calibrated_null",
        "purpose": "type_i_error",
        "design": "Paired homoscedastic Gaussian constant-variance null scenarios with the frozen fixed-score contract.",
        "seed_policy": "Indexed deterministic streams with stable replicate ordering.",
        "metrics": ["rejection_rate", "binomial_confidence_interval"],
        "acceptance_rule": "The preregistered null-calibration boundary in the reference report must pass."
      },
      {
        "id": "calibrated_signal",
        "purpose": "power",
        "design": "Paired homoscedastic Gaussian constant-variance signal scenarios using the same frozen designs as the null calibration.",
        "seed_policy": "Indexed deterministic streams with stable replicate ordering.",
        "metrics": ["rejection_rate", "null_to_signal_separation"],
        "acceptance_rule": "The preregistered power boundary in the reference report must pass."
      }
    ],
    "boundaries": [
      {
        "id": "singular_reduced_model",
        "category": "data_pathology",
        "case": "The reduced structural design is singular.",
        "expected_behavior": "Execution is rejected with a typed diagnostic and no partial inference payload."
      },
      {
        "id": "unsupported_measurement_reestimation",
        "category": "unsupported_scope",
        "case": "The recipe requests measurement-model re-estimation within permutations.",
        "expected_behavior": "The recipe is blocked before execution."
      },
      {
        "id": "row_and_construct_reorder",
        "category": "metamorphic",
        "case": "Rows or constructs are consistently reordered.",
        "expected_behavior": "Mapped path estimates and probabilities remain equal within the frozen tolerance."
      },
      {
        "id": "worker_invariance",
        "category": "determinism",
        "case": "The same recipe is executed with one and four workers.",
        "expected_behavior": "Analytical payloads, permutation ordering, exceedances, and probabilities are exactly equal."
      },
      {
        "id": "manifest_and_result_tamper",
        "category": "tamper",
        "case": "A saved parameter manifest, method identity, or probability is altered.",
        "expected_behavior": "Strict project validation rejects the archive."
      }
    ],
    "numerical_tolerance": 0.000001
  },

  "feature": {
    "id": "qpls3.pls.consistent",
    "label": "Consistent PLS-SEM",
    "method_version": "plsc_v2",
    "method_kind": "deterministic",
    "catalogue_snapshot_date": "2026-08-12",
    "catalogue_url": "https://smartpls.com/documentation/algorithms-and-techniques/core-algorithm/consistent-pls/"
  },
  "claim": {
    "supported_scope": "Reflective-only consistent PLS for recursive models with at least two indicators per construct and path or factor inner weighting.",
    "estimand": "Dijkstra-Henseler rho_A reliabilities and the attenuation-corrected construct correlations, structural paths, outer loadings, and R-squared values derived from the converged ordinary Mode A PLS solution.",
    "assumptions": [
      "Every construct is reflective with at least two indicators and the ordinary PLS solution is admissible.",
      "The rho_A correction and corrected correlation matrix pass the frozen finite-sample admissibility policy.",
      "Complete-case preprocessing and path or factor weighting are persisted in the typed recipe."
    ],
    "exclusions": [
      "Formative blocks, PCA weighting, generated interactions, and higher-order expansion are excluded.",
      "Bootstrap, permutation, studentized inference, and consistent resampling are separate workflows and are not qualified here.",
      "Historical plsc_v1 output is compatibility data and is not current scientific evidence."
    ],
    "warnings": [
      "A materially inadmissible rho_A or corrected construct correlation fails rather than being clamped into an acceptable result.",
      "Two-indicator constructs are supported but contain limited reliability information."
    ]
  },
  "scientific_contract": {
    "equations": [
      {
        "id": "dijkstra_henseler_rho_a",
        "expression": "rho_A = (w'w)^2 * [w'(R - diag(R))w] / [w'(ww' - diag(ww'))w]",
        "variables": ["rho_A", "w", "R", "diag"],
        "source_reference_id": "dijkstra_henseler_2015"
      },
      {
        "id": "attenuation_correction",
        "expression": "cor_corrected(j,k) = cor_original(j,k) / sqrt(rho_A_j rho_A_k)",
        "variables": ["cor_corrected", "cor_original", "rho_A_j", "rho_A_k"],
        "source_reference_id": "dijkstra_henseler_2015"
      }
    ],
    "references": [
      {
        "id": "dijkstra_henseler_2015",
        "kind": "primary_paper",
        "citation": "Dijkstra and Henseler (2015), Consistent Partial Least Squares Path Modeling, MIS Quarterly 39(2)",
        "locator": "https://doi.org/10.25300/MISQ/2015/39.2.02",
        "independence_group": "primary_plsc_method",
        "runtime_policy": "no_runtime_dependency"
      },
      {
        "id": "independent_numpy_plsc",
        "kind": "independent_python",
        "citation": "Independent NumPy Equation 3 and attenuation-correction implementation",
        "locator": "validation/plsc_reference.py",
        "independence_group": "python_reference",
        "runtime_policy": "development_validation_only"
      },
      {
        "id": "hand_rho_a_fixture",
        "kind": "hand_calculation",
        "citation": "Committed hand-calculated rho_A and corrected-correlation fixture",
        "locator": "docs/methods/PLSC_V2.md",
        "independence_group": "hand_reference",
        "runtime_policy": "no_runtime_dependency"
      }
    ],
    "simulations": [
      {
        "id": "reflective_parameter_recovery",
        "purpose": "recovery",
        "design": "Reflective recursive models spanning reliability, loading strength, structural effects, sample size, two-indicator blocks, and near-inadmissible corrections.",
        "seed_policy": "Frozen scenario-indexed data seeds shared with the independent reference only through source observations.",
        "metrics": ["rho_a_reference_delta", "corrected_path_reference_delta", "corrected_loading_reference_delta", "latent_path_recovery_error", "inadmissible_rejection_rate"],
        "acceptance_rule": "Every admissible supported scenario agrees with the independent implementation within 1e-6 and recovers its latent sample path within 0.10; every preregistered inadmissible control is rejected and counted without clamping."
      }
    ],
    "boundaries": [
      {"id": "inadmissible_reliability_or_correlation", "category": "data_pathology", "case": "Finite-sample rho_A is materially nonpositive or above one, or attenuation correction produces a correlation outside [-1,1].", "expected_behavior": "Calculation fails with a typed inadmissibility diagnostic and no PLSc result is committed."},
      {"id": "formative_or_generated_construct", "category": "unsupported_scope", "case": "The model contains a formative block, generated interaction, higher-order construct, or PCA weighting.", "expected_behavior": "The typed validator blocks the PLSc recipe before execution."},
      {"id": "construct_indicator_reorder", "category": "metamorphic", "case": "Reflective constructs and indicators are consistently reordered.", "expected_behavior": "Mapped rho_A, corrected correlations, paths, loadings, and R-squared remain equal within tolerance."},
      {"id": "repeat_execution", "category": "determinism", "case": "The same recipe and dataset fingerprint are executed repeatedly.", "expected_behavior": "The analytical PLSc payload is bit-identical apart from operational identifiers and timestamps."},
      {"id": "plsc_version_or_correction_tamper", "category": "tamper", "case": "The saved rho_A, corrected correlation, path, loading, method version, or legacy marker is altered.", "expected_behavior": "Strict project validation rejects the archive rather than displaying the modified PLSc result."}
    ],
    "numerical_tolerance": 0.000001
  },
  "product_contract": {
    "persistence": {
      "recipe_schema_version": 3,
      "result_schema_version": 1,
      "payload_kind": "pls_pm_v1",
      "tamper_tests": [
        {"category": "feature_identity", "expected_behavior": "Reject a result whose capability identity does not match its PLSc recipe."},
        {"category": "method_version", "expected_behavior": "Reject plsc_v1, unknown, or relabeled PLSc payloads as current v2 evidence."},
        {"category": "dataset_fingerprint", "expected_behavior": "Reject a PLSc result whose dataset fingerprint no longer matches."},
        {"category": "checksum", "expected_behavior": "Reject any changed archive member whose checksum differs."},
        {"category": "malformed_payload", "expected_behavior": "Reject duplicate keys, unknown fields, non-finite corrections, or inconsistent dimensions."},
        {"category": "legacy_reinterpretation", "expected_behavior": "Preserve readable plsc_v1 data under its legacy identity without current reinterpretation."}
      ],
      "legacy_policy": "plsc_v1 remains readable only as explicitly unqualified legacy compatibility data; new results must use plsc_v2."
    },
    "native": {
      "setup_controls": ["Reflective model", "Path or factor weighting", "Preprocessing", "Tolerance", "Maximum iterations"],
      "applicability_blockers": ["Formative construct", "Fewer than two indicators", "PCA weighting", "Interaction or higher-order construct", "External resampling setting"],
      "result_surfaces": ["PLSc correction reliability", "PLSc construct correlations", "Corrected paths", "Corrected loadings", "Corrected R-square", "Run provenance"],
      "gui_cli_parity_rule": "For the same typed PLSc recipe and dataset fingerprint, GUI and CLI analytical payloads must be exactly equal apart from operational timestamps and run identifiers.",
      "accessibility_rules": ["Correction tables and inadmissibility warnings are keyboard and screen-reader accessible.", "No corrected value is conveyed by color alone."]
    },
    "export": {
      "formats": ["csv", "xlsx", "html", "svg", "png"],
      "tables": ["PLSc correction reliability", "PLSc construct correlations", "Corrected paths", "Corrected loadings", "Corrected R-square", "Run provenance"],
      "same_run_required": true,

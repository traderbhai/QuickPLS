  "feature": {
    "id": "qpls3.assessment.ipma",
    "label": "Importance-Performance Map Analysis",
    "method_version": "ipma_v1",
    "method_kind": "deterministic",
    "catalogue_snapshot_date": "2026-08-12",
    "catalogue_url": "https://smartpls.com/documentation/algorithms-and-techniques/"
  },
  "claim": {
    "supported_scope": "One endogenous target with predecessor-only PLS total-effect importance and observed-range construct and indicator performance on a fixed 0-100 scale.",
    "estimand": "For each structural predecessor of the selected target, its PLS total effect as importance and its observed-range min-max scaled score mean as performance.",
    "assumptions": [
      "The selected target is endogenous and the underlying PLS solution satisfies its accepted bounded contract.",
      "Construct and indicator score ranges are finite and nonconstant for every reported predecessor.",
      "The selected target, range convention, and exclusions are persisted with the run."
    ],
    "exclusions": [
      "Conditional IPMA, multiple simultaneous targets, theoretical-range correction, and cIPMA are excluded.",
      "Case-weighted, interaction, and higher-order models are excluded.",
      "Disconnected constructs and the target itself are excluded from the predecessor map."
    ],
    "warnings": [
      "Observed-range performance is sample-dependent and must not be read as an absolute population score.",
      "High importance or performance does not establish causality or intervention effectiveness."
    ]
  },
  "scientific_contract": {
    "equations": [
      {
        "id": "total_importance",
        "expression": "importance(i,t) = sum over all directed paths p from i to t of product(beta_e for e in p)",
        "variables": [
          "importance",
          "i",
          "t",
          "p",
          "beta_e"
        ],
        "source_reference_id": "ringle_sarstedt_2016"
      },
      {
        "id": "observed_range_performance",
        "expression": "performance(z) = 100 * mean((z - min(z)) / (max(z) - min(z)))",
        "variables": [
          "performance",
          "z"
        ],
        "source_reference_id": "ringle_sarstedt_2016"
      }
    ],
    "references": [
      {
        "id": "ringle_sarstedt_2016",
        "kind": "primary_paper",
        "citation": "Ringle and Sarstedt (2016), Gain More Insight from Your PLS-SEM Results: The Importance-Performance Map Analysis",
        "locator": "docs/methods/IPMA_V1.md",
        "independence_group": "published_ipma_method",
        "runtime_policy": "no_runtime_dependency"
      },
      {
        "id": "independent_python_ipma",
        "kind": "independent_python",
        "citation": "Independent Python total-effect and observed-range performance calculation",
        "locator": "validation/ipma_reference.py",
        "independence_group": "python_reference",
        "runtime_policy": "development_validation_only"
      }
    ],
    "simulations": [
      {
        "id": "importance_performance_recovery",
        "purpose": "recovery",
        "design": "One frozen direct-plus-mediated model with a disconnected negative-control component is checked against an independent Python calculation; a focused engine matrix reverses construct and path order and exercises listwise omission.",
        "seed_policy": "The deterministic fixture and selected target are frozen; no stochastic simulation or resampling claim is made.",
        "metrics": [
          "total_effect_error",
          "construct_performance_error",
          "indicator_performance_error",
          "predecessor_set_accuracy"
        ],
        "acceptance_rule": "All predecessor sets and table rows must match the independent calculation within 1e-6, with no disconnected or target rows."
      }
    ],
    "boundaries": [
      {
        "id": "constant_performance_score",
        "category": "data_pathology",
        "case": "A required construct or indicator score has zero observed range.",
        "expected_behavior": "Constant raw indicators are blocked during preprocessing; any later empty, non-finite, or zero-range IPMA score fails closed with a typed estimator error and no result is emitted."
      },
      {
        "id": "unsupported_ipma_shape",
        "category": "unsupported_scope",
        "case": "The user requests cIPMA, theoretical ranges, an interaction, or a higher-order target.",
        "expected_behavior": "The workflow blocks the unsupported request before execution."
      },
      {
        "id": "model_reorder",
        "category": "metamorphic",
        "case": "Construct and path declarations are consistently reordered.",
        "expected_behavior": "Mapped predecessor, importance, and performance rows remain equal within tolerance."
      },
      {
        "id": "repeat_ipma",
        "category": "determinism",
        "case": "The same model, target, and data are executed repeatedly.",
        "expected_behavior": "The analytical IPMA payload is exactly equal apart from timestamps."
      },
      {
        "id": "ipma_archive_tamper",
        "category": "tamper",
        "case": "The target, total effect, performance row, range convention, or identity is altered.",
        "expected_behavior": "Strict project validation rejects the archive."
      }
    ],
    "numerical_tolerance": 1e-06
  },
  "product_contract": {
    "persistence": {
      "recipe_schema_version": 3,
      "result_schema_version": 1,
      "payload_kind": "pls_pm_v1",
      "tamper_tests": [

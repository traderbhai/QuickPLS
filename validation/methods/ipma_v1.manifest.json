        },
        {
          "category": "checksum",
          "expected_behavior": "Reject an archive member whose checksum differs from the manifest."
        },
        {
          "category": "malformed_payload",
          "expected_behavior": "Reject duplicate keys, unknown fields, non-finite values, inconsistent targets, or impossible performance rows."
        },
        {
          "category": "legacy_reinterpretation",
          "expected_behavior": "Never reinterpret a historical score map as current IPMA v1 evidence."
        }
      ],
      "legacy_policy": "Historical IPMA previews retain their original identity and cannot satisfy current promotion evidence."
    },
    "native": {

  "feature": {
    "id": "qpls3.pls.algorithm",
    "label": "PLS-SEM Algorithm",
    "method_version": "pls_pm_v1",
    "method_kind": "deterministic",
    "catalogue_snapshot_date": "2026-08-12",
    "catalogue_url": "https://smartpls.com/documentation/algorithms-and-techniques/core-algorithm/pls/"
  },
  "claim": {
    "supported_scope": "Deterministic PLS path modelling for supported recursive composite models with numeric raw observations, reflective Mode A, formative Mode B, single-item blocks, and path, factor, or bounded PCA block weighting.",
    "estimand": "The converged PLS composite scores, outer weights and loadings, standardized recursive structural path coefficients, R-squared values, and deterministic direct, indirect, and total effects for the declared model.",
    "assumptions": [
      "The structural model is recursive and every measurement block and indicator assignment passes the typed recipe validator.",
      "Listwise-deleted complete observations are finite and each estimated block retains nonzero variance.",
      "The selected preprocessing, weighting scheme, tolerance, and iteration limit are persisted as part of the run identity."
    ],
    "exclusions": [
      "Cyclic structural models, covariance-only input, unspecified missing-data treatment, and untyped model extensions are excluded.",
      "This contract does not itself qualify bootstrap, permutation, prediction, group comparison, PLSc, WPLS, or CB-SEM inference.",
      "QuickPLS does not claim numerical identity with another implementation's initialization, orientation, or convergence path outside the frozen invariants."
    ],
    "warnings": [
      "PLS composite estimates are model- and preprocessing-dependent and do not by themselves establish causality.",
      "Inferential interpretation requires a separately qualified inference workflow."
    ]
  },
  "scientific_contract": {
    "equations": [
      {
        "id": "outer_score_update",
        "expression": "y_j = standardize(sum_k w_jk x_jk)",
        "variables": [
          "y_j",
          "w_jk",
          "x_jk"
        ],
        "source_reference_id": "wold_1982"
      },
      {
        "id": "structural_path_estimate",
        "expression": "beta_j = (Y_pred' Y_pred)^-1 Y_pred' y_j",
        "variables": [
          "beta_j",
          "Y_pred",
          "y_j"
        ],
        "source_reference_id": "lohmoeller_1989"
      }
    ],
    "references": [
      {
        "id": "wold_1982",
        "kind": "primary_paper",
        "citation": "Wold (1982), Soft Modeling: The Basic Design and Some Extensions",
        "locator": "docs/methods/PLS_PM_V1.md",
        "independence_group": "published_pls_algorithm",
        "runtime_policy": "no_runtime_dependency"
      },
      {
        "id": "lohmoeller_1989",
        "kind": "primary_paper",
        "citation": "Lohmoller (1989), Latent Variable Path Modeling with Partial Least Squares",
        "locator": "docs/methods/PLS_PM_V1.md",
        "independence_group": "published_pls_monograph",
        "runtime_policy": "no_runtime_dependency"
      },
      {
        "id": "independent_python_plspm",
        "kind": "independent_python",
        "citation": "Independent Python implementation used for fixed QuickPLS PLS reference fixtures",
        "locator": "validation/python_plspm_reference.py",
        "independence_group": "python_reference",
        "runtime_policy": "development_validation_only"
      }
    ],
    "simulations": [
      {
        "id": "parameter_recovery",
        "purpose": "recovery",
        "design": "Seven frozen scenarios covering path-, factor-, and PCA-weighted reflective models, mixed Mode B, single-item blocks, listwise missingness, and a non-Gaussian factor-weighted model.",
        "seed_policy": "Frozen scenario-indexed seeds; deterministic estimator runs use identical generated rows across implementations.",
        "metrics": [
          "path_bias",
          "loading_bias",
          "weight_error",
          "convergence_rate"
        ],
        "acceptance_rule": "Every executed scenario in the frozen seven-scenario matrix must meet its preregistered recovery tolerance; every scenario and failure remains counted. This bounded qualification makes no population-wide 99 percent convergence claim."
      }
    ],
    "boundaries": [
      {
        "id": "constant_or_singular_block",
        "category": "data_pathology",
        "case": "A retained indicator block or predecessor score has zero variance or a singular required regression design.",
        "expected_behavior": "Execution fails with a typed numerical diagnostic and emits no partial current result."
      },
      {
        "id": "cycle_or_untyped_extension",
        "category": "unsupported_scope",
        "case": "The structural graph is cyclic or the recipe requests an unqualified method extension.",
        "expected_behavior": "The typed recipe validator blocks execution before estimation."
      },
      {
        "id": "row_construct_indicator_reorder",
        "category": "metamorphic",
        "case": "Rows, constructs, paths, and indicators are consistently reordered without changing the model or observations.",
        "expected_behavior": "Mapped estimates remain equal within the frozen numerical tolerance and canonical identities remain stable."
      },
      {
        "id": "repeat_execution",
        "category": "determinism",
        "case": "The same typed recipe and dataset fingerprint are executed repeatedly.",
        "expected_behavior": "Analytical payloads are bit-identical apart from explicitly operational identifiers and timestamps."
      },
      {
        "id": "archive_parameter_tamper",
        "category": "tamper",
        "case": "A saved model path, measurement assignment, estimate, method identity, or dataset fingerprint is altered.",
        "expected_behavior": "Strict project validation rejects the archive rather than displaying the modified result."
      }
    ],
    "numerical_tolerance": 1e-06
  },

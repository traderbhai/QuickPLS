      "workflow_steps": ["setup", "invalid_setup_blocked", "execute", "inspect_results", "export", "save", "close", "reopen_same_run", "observe_application_requests", "record_platform_background_egress", "cleanup"],
      "viewports": ["1024x700", "1280x720", "1440x900"],
      "offline_required": true,

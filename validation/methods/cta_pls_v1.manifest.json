  "feature": {
    "id": "qpls3.assessment.cta_pls",
    "label": "CTA-PLS Descriptive Tetrad Diagnostics",
    "method_version": "cta_pls_tetrad_v1",
    "method_kind": "deterministic",
    "catalogue_snapshot_date": "2026-08-12",
    "catalogue_url": "https://smartpls.com/documentation/algorithms-and-techniques/"
  },
  "claim": {
    "supported_scope": "Descriptive sample-covariance tetrad diagnostics for supported PLS indicator blocks containing at least four indicators, using the exact complete-case preprocessing of the associated PLS run.",
    "estimand": "Every signed and absolute tetrad for each ordered four-indicator subset and the maximum absolute tetrad within each eligible construct block.",
    "assumptions": [
      "Indicator covariances are computed from the same preprocessed complete-case rows used by the PLS execution recipe.",
      "Each evaluated construct has at least four mapped numeric indicators with nonzero finite variance.",
      "The three frozen tetrad pairings are reported for every ordered four-indicator subset."
    ],
    "exclusions": [
      "Bootstrap, permutation, or asymptotic tetrad inference and vanishing-tetrad decisions are excluded.",
      "PCA weighting and indicator blocks with fewer than four indicators are excluded.",
      "The diagnostic does not classify a measurement model as reflective or formative."
    ],
    "warnings": [
      "A small or large sample tetrad is descriptive and is not a significance decision.",
      "Release qualification of this bounded diagnostic does not establish the broader inferential CTA-PLS catalogue workflow.",
      "Method-level functional offline qualification proves no external application request or runtime network dependency; it records but does not waive WebView2 process-tree background egress, which remains subject to the separate strict commercial zero-egress gate."
    ]
  },
  "scientific_contract": {
    "equations": [
      {
        "id": "sample_covariance",
        "expression": "s_ab = sum_i (a_i - mean(a))(b_i - mean(b)) / (n - 1)",
        "variables": ["s_ab", "a_i", "b_i", "n"],
        "source_reference_id": "gudergan_ringle_wende_will_2008"
      },
      {
        "id": "tetrad_pairing",
        "expression": "tau_ab_cd = s_ab * s_cd - s_ac * s_bd",
        "variables": ["tau_ab_cd", "s_ab", "s_cd", "s_ac", "s_bd"],
        "source_reference_id": "gudergan_ringle_wende_will_2008"
      }
    ],
    "references": [
      {
        "id": "gudergan_ringle_wende_will_2008",
        "kind": "primary_paper",
        "citation": "Gudergan, Ringle, Wende, and Will (2008), Confirmatory Tetrad Analysis in PLS Path Modeling, Journal of Business Research 61(12), 1238-1249",
        "locator": "https://doi.org/10.1016/j.jbusres.2008.01.012",
        "independence_group": "primary_cta_pls_method",
        "runtime_policy": "no_runtime_dependency"
      },
      {
        "id": "independent_python_cta",
        "kind": "independent_python",
        "citation": "Independent Python sample-covariance and complete tetrad-pairing implementation",
        "locator": "validation/cta_pls_reference.py",
        "independence_group": "python_reference",
        "runtime_policy": "development_validation_only"
      }
    ],
    "simulations": [
      {
        "id": "tetrad_recovery",
        "purpose": "recovery",
        "design": "Eligible four-to-six-indicator blocks spanning vanishing and non-vanishing population tetrads, varied loadings, sample sizes, and bounded nonnormality.",
        "seed_policy": "Frozen scenario-indexed generators; QuickPLS and the independent reference receive identical rows and indicator order.",
        "metrics": ["tetrad_error", "maximum_tetrad_error", "eligible_block_count", "pairing_completeness"],
        "acceptance_rule": "Every expected pairing must be present exactly once and mapped signed and absolute tetrads must agree with the independent reference within 1e-6."
      }
    ],
    "boundaries": [
      {"id": "constant_or_nonfinite_indicator", "category": "data_pathology", "case": "An eligible block contains a constant, nonnumeric, or nonfinite indicator after the declared missing-data policy.", "expected_behavior": "Validation blocks execution or reports the exact ineligible indicator; no partial CTA payload is emitted."},
      {"id": "insufficient_indicator_block", "category": "unsupported_scope", "case": "No construct contains four or more supported indicators or PCA weighting is selected.", "expected_behavior": "The recipe is rejected before estimation with a CTA-specific applicability message."},
      {"id": "indicator_reorder", "category": "metamorphic", "case": "Rows or indicators are consistently reordered without changing the block membership.", "expected_behavior": "Canonicalized construct, indicator-set, and pairing results remain equal within the frozen tolerance."},
      {"id": "repeatability", "category": "determinism", "case": "The same data fingerprint and recipe are executed repeatedly.", "expected_behavior": "The analytical CTA payload is exactly equal apart from operational identifiers and timestamps."},
      {"id": "tetrad_archive_tamper", "category": "tamper", "case": "A saved indicator identity, covariance convention, tetrad value, block maximum, or method version is altered.", "expected_behavior": "Strict project validation rejects the archive instead of displaying the changed diagnostic."}
    ],
    "numerical_tolerance": 0.000001
  },
  "product_contract": {
    "persistence": {
      "recipe_schema_version": 3,
      "result_schema_version": 1,
      "payload_kind": "pls_pm_v1",
      "tamper_tests": [
        {"category": "feature_identity", "expected_behavior": "Reject a result whose CTA capability identity differs from its recipe."},
        {"category": "method_version", "expected_behavior": "Reject a CTA payload relabeled with another method version."},
        {"category": "dataset_fingerprint", "expected_behavior": "Reject a CTA result whose saved dataset fingerprint no longer matches."},
        {"category": "checksum", "expected_behavior": "Reject any modified archive member whose checksum differs."},
        {"category": "malformed_payload", "expected_behavior": "Reject duplicate keys, unknown fields, non-finite values, incomplete pairings, or inconsistent block maxima."},
        {"category": "legacy_reinterpretation", "expected_behavior": "Never reinterpret an unversioned tetrad preview or a broader inferential CTA claim as current v1 evidence."}
      ],
      "legacy_policy": "Historical or unversioned tetrad output remains readable only as explicitly non-current preview data."
    },
    "native": {
      "setup_controls": ["CTA-PLS calculation selection", "PLS weighting and preprocessing", "Eligible indicator-block summary"],
      "applicability_blockers": ["No block with four indicators", "PCA weighting", "Invalid indicator data", "Unsupported measurement shape"],
      "result_surfaces": ["CTA-PLS tetrad summary", "Complete tetrad-pairing table", "Assumptions and exclusions", "Run provenance"],
      "gui_cli_parity_rule": "For the same recipe, dataset fingerprint, and method version, GUI and CLI tetrad payloads must be exactly equal apart from operational identifiers and timestamps.",
      "accessibility_rules": ["Every tetrad and block maximum is available in an accessible table.", "Warnings and applicability failures do not rely on color or diagram interaction."]
    },
    "export": {
      "formats": ["csv", "xlsx", "html"],
      "tables": ["CTA-PLS tetrad summary", "CTA-PLS tetrads", "Run provenance"],
      "same_run_required": true,
      "provenance_required": true
    },
    "packaged": {

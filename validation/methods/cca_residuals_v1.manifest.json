  "feature": {
    "id": "qpls3.assessment.cca_residuals",
    "label": "CCA Composite Residual Diagnostics",
    "method_version": "cca_composite_residual_v1",
    "method_kind": "deterministic",
    "catalogue_snapshot_date": "2026-08-12",
    "catalogue_url": "https://smartpls.com/documentation/algorithms-and-techniques/"
  },
  "claim": {
    "supported_scope": "Descriptive observed-versus-reproduced composite-correlation residual diagnostics for a supported recursive standardized composite path model.",
    "estimand": "The residual matrix obtained by subtracting model-implied composite correlations from observed composite correlations under the frozen QuickPLS composite model.",
    "assumptions": [
      "The underlying PLS model and composite scores satisfy the accepted bounded PLS contract.",
      "The model is recursive, standardized, and estimated from complete finite observations.",
      "Residuals are interpreted descriptively and retain their signed direction."
    ],
    "exclusions": [
      "Resampled CCA inference, global fit tests, thresholds, and pass or fail classification are excluded.",
      "Reflective-versus-formative classification and causal interpretation are excluded.",
      "This bounded residual diagnostic is not a claim of full confirmatory composite analysis parity."
    ],
    "warnings": [
      "Small residuals do not establish a correct model or causal identification.",
      "Residual magnitude must be interpreted with the documented model and descriptive scope."
    ]
  },
  "scientific_contract": {
    "equations": [
      {
        "id": "composite_residual",
        "expression": "R_residual = R_observed - R_implied",
        "variables": [
          "R_residual",
          "R_observed",
          "R_implied"
        ],
        "source_reference_id": "henseler_2014"
      }
    ],
    "references": [
      {
        "id": "henseler_2014",
        "kind": "primary_paper",
        "citation": "Henseler et al. (2014), Common Beliefs and Reality About PLS: Comments on Ronkko and Evermann",
        "locator": "docs/methods/PLS_CCA_V1.md",
        "independence_group": "published_composite_assessment",
        "runtime_policy": "no_runtime_dependency"
      },
      {
        "id": "independent_python_residual",
        "kind": "independent_python",
        "citation": "Independent Python composite-correlation residual calculation for QuickPLS validation fixtures",
        "locator": "validation/cca_reference.py",
        "independence_group": "python_reference",
        "runtime_policy": "development_validation_only"
      }
    ],
    "simulations": [
      {
        "id": "residual_recovery",
        "purpose": "recovery",
        "design": "Supported recursive composite models with exact-fit, mild misspecification, and strong misspecification scenarios across sample sizes and indicator orderings.",
        "seed_policy": "Every stochastic fixture uses a frozen scenario seed; deterministic fixture calculations use no random stream.",
        "metrics": [
          "maximum_absolute_residual",
          "root_mean_squared_residual",
          "matrix_symmetry"
        ],
        "acceptance_rule": "QuickPLS residual matrices must match the independent calculation within 1e-6 and preserve exact symmetry and diagonal conventions."
      }
    ],
    "boundaries": [
      {
        "id": "constant_composite",
        "category": "data_pathology",
        "case": "A composite score has zero or non-finite variance.",
        "expected_behavior": "The calculation is blocked with the affected construct identified."
      },
      {
        "id": "unsupported_inference",
        "category": "unsupported_scope",
        "case": "A user requests inferential CCA or a pass/fail classification.",
        "expected_behavior": "The workflow remains descriptive and does not fabricate a threshold or p value."
      },
      {
        "id": "construct_reorder",
        "category": "metamorphic",
        "case": "Constructs and indicators are consistently reordered.",
        "expected_behavior": "The mapped residual matrix remains numerically equal within tolerance."
      },
      {
        "id": "repeat_run",
        "category": "determinism",
        "case": "The same data, model, and settings are executed repeatedly.",
        "expected_behavior": "The analytical residual payload is exactly equal apart from operational timestamps."
      },
      {
        "id": "residual_archive_tamper",
        "category": "tamper",
        "case": "A saved residual, method identity, or model fingerprint is changed.",
        "expected_behavior": "Strict archive validation rejects the result rather than displaying altered diagnostics."
      }
    ],
    "numerical_tolerance": 1e-06
  },
  "product_contract": {
    "persistence": {
      "recipe_schema_version": 3,
      "result_schema_version": 1,
      "payload_kind": "pls_pm_v1",
      "tamper_tests": [

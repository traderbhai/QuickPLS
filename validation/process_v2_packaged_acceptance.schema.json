    "resourceSample": {
      "type": "object", "additionalProperties": false,
      "required": [
        "recorded_at_utc", "root_present", "root_pid", "total_working_set_bytes",
        "total_private_memory_bytes", "total_handle_count", "total_thread_count",
        "process_role_counts", "processes"
      ],
      "properties": {
        "recorded_at_utc": { "type": "string", "format": "date-time" },
        "root_present": { "const": true },
        "root_pid": { "type": "integer", "minimum": 1 },
        "total_working_set_bytes": { "type": "integer", "minimum": 1 },
        "total_private_memory_bytes": { "type": "integer", "minimum": 1 },
        "total_handle_count": { "type": "integer", "minimum": 1 },
        "total_thread_count": { "type": "integer", "minimum": 1 },
        "process_role_counts": { "$ref": "#/$defs/resourceRoleCounts" },
        "processes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resourceProcess" } }
      }
    }
  }

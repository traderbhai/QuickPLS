        "working_set_bytes": { "type": "integer", "minimum": 1 },
        "private_memory_bytes": { "type": "integer", "minimum": 1 },
        "handle_count": { "type": "integer", "minimum": 1 },
        "thread_count": { "type": "integer", "minimum": 1 }
      }

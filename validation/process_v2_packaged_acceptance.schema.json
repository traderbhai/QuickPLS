    "resourceRoleCounts": {
      "type": "object", "additionalProperties": false,
      "required": [
        "desktop_root", "webview_browser", "webview_renderer", "webview_gpu",
        "webview_utility", "webview_other", "other_descendant"
      ],
      "properties": {
        "desktop_root": { "const": 1 },
        "webview_browser": { "type": "integer", "minimum": 0 },
        "webview_renderer": { "type": "integer", "minimum": 0 },
        "webview_gpu": { "type": "integer", "minimum": 0 },
        "webview_utility": { "type": "integer", "minimum": 0 },
        "webview_other": { "type": "integer", "minimum": 0 },
        "other_descendant": { "type": "integer", "minimum": 0 }
      }

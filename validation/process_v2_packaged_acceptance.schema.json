        "passed": { "const": true },
        "original_path": { "type": "string", "pattern": "^validation/results/v247-native-process-v2-[^/]+\\.qpls$" },
        "reset_path": { "type": "string", "pattern": "^validation/results/v247-native-process-v2-reset-[^/]+\\.qpls$" },
        "distinct_path": { "const": true },
        "original_archive": { "$ref": "#/$defs/artifact" },

    "resources": {
      "type": "object", "additionalProperties": false,
      "required": [
        "passed", "sample_count", "raw_sample_count", "first_sample", "monitor_terminal_reason",
        "peak_working_set_bytes", "peak_private_memory_bytes", "peak_working_set_under_2_gib", "policy",
        "cancellation_within_baseline_tolerance", "equal_state_working_set_within_tolerance",
        "equal_state_private_memory_within_tolerance", "equal_state_handle_count_within_tolerance",
        "equal_state_thread_count_within_tolerance", "equal_state_process_roles_exact",
        "process_roles_bounded_and_terminally_stable",
        "retained_history_disclosure", "phase_snapshots_attested", "phase_document_attested",
        "conclusion", "cancellation_cycle_count",
        "completed_cycle_count", "idle_checkpoint_count",
        "idle_settle_milliseconds", "idle_checkpoints_ordered_and_distinct",
        "capture_delay_milliseconds", "sample_window_milliseconds", "minimum_samples_per_checkpoint",
        "checkpoint_diagnostic_count", "checkpoint_diagnostics_all_passed",
        "artifact_disk_deltas_recorded", "zero_lingering_descendants",
        "graceful_exit_confirmed", "parent_absent", "forced_parent_termination",
        "forced_descendant_pids", "forced_resource_monitor_termination", "source_check"
      ],
      "properties": {

        "sample_count": { "type": "integer", "minimum": 30 },
        "raw_sample_count": { "type": "integer", "minimum": 30 },
        "first_sample": { "$ref": "#/$defs/resourceSample" },
        "monitor_terminal_reason": { "const": "stop_signal" },
        "peak_working_set_bytes": { "type": "integer", "minimum": 1 },
        "peak_private_memory_bytes": { "type": "integer", "minimum": 1 },
        "peak_working_set_under_2_gib": { "const": true },
        "policy": { "const": "bounded_equal_logical_state_window_median_v2" },
        "cancellation_within_baseline_tolerance": { "const": true },
        "equal_state_working_set_within_tolerance": { "const": true },
        "equal_state_private_memory_within_tolerance": { "const": true },
        "equal_state_handle_count_within_tolerance": { "const": true },
        "equal_state_thread_count_within_tolerance": { "const": true },
        "equal_state_process_roles_exact": { "const": true },
        "process_roles_bounded_and_terminally_stable": { "const": true },
        "retained_history_disclosure": {
          "type": "object", "additionalProperties": false,
          "required": [
            "checkpoint", "median_working_set_bytes", "median_private_memory_bytes",
            "completed_result_count", "witness_count", "qualification_role"
          ],
          "properties": {
            "checkpoint": { "const": "post_completed_history_2_idle" },
            "median_working_set_bytes": { "type": "integer", "minimum": 1 },
            "median_private_memory_bytes": { "type": "integer", "minimum": 1 },
            "completed_result_count": { "const": 2 },
            "witness_count": { "const": 2 },
            "qualification_role": { "const": "disclosure_only_not_a_threshold" }
          }
        },
        "phase_snapshots_attested": { "const": true },
        "phase_document_attested": { "const": true },
        "conclusion": { "const": "bounded_post_replacement_recovery_v2" },
        "cancellation_cycle_count": { "const": 1 },
        "completed_cycle_count": { "const": 2 },
        "idle_checkpoint_count": { "const": 5 },
        "idle_settle_milliseconds": { "const": 5000 },
        "idle_checkpoints_ordered_and_distinct": { "const": true },
        "capture_delay_milliseconds": { "const": 500 },
        "sample_window_milliseconds": { "const": 5000 },
        "minimum_samples_per_checkpoint": { "const": 6 },
        "checkpoint_diagnostic_count": { "const": 5 },
        "checkpoint_diagnostics_all_passed": { "const": true },
        "artifact_disk_deltas_recorded": { "const": true },
        "zero_lingering_descendants": { "const": true },
        "graceful_exit_confirmed": { "const": true },
        "parent_absent": { "const": true },
        "forced_parent_termination": { "const": false },
        "forced_descendant_pids": { "type": "array", "maxItems": 0 },
        "forced_resource_monitor_termination": { "const": false },
        "source_check": { "const": "processV2Resources" }
      }
    },
    "resourceProcess": {
      "type": "object", "additionalProperties": false,
      "required": [
        "pid", "parent_pid", "name", "role", "creation_date", "working_set_bytes",
        "private_memory_bytes", "handle_count", "thread_count"
      ],
      "properties": {
        "pid": { "type": "integer", "minimum": 1 },
        "parent_pid": { "type": "integer", "minimum": 0 },

      "properties": {
        "passed": { "type": "boolean" }, "archive_only": { "type": "boolean" },
        "witness_method_version": { "const": "regression_process_bootstrap_validation_witness_v1" },
        "estimand_order_exact": { "type": "boolean" }, "bootstrap_index_partition_exact": { "type": "boolean" },
        "jackknife_index_partition_exact": { "type": "boolean" }, "excluded_from_results": { "type": "boolean" },
        "excluded_from_exports": { "type": "boolean" }, "source_check": { "const": "processV2WitnessBoundary" }
      }
    },
    "resourceReset": {
      "type": "object", "additionalProperties": false,
      "required": [
        "passed", "original_path", "reset_path", "distinct_path", "original_archive", "reset_archive",

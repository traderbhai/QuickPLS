  "collector_contract": {
    "schema_version": 1,
    "suite_id": "quickpls_v255_named_evidence_collector_v1",
    "case_receipt_suite_id": "quickpls_v255_named_evidence_case_receipt_v1",
    "candidate_report_suite_id": "quickpls_v255_installed_portable_smoke_v3",

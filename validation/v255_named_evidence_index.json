      { "schema_version": 1, "suite_id": "quickpls_v255_cross_method_candidate_wrapper_v1" }
    ],
    "required_observation": {
      "schema_version": 1,
      "case_id": "exact frozen case id",
      "operation": "exact operation selected by operation_by_group",
      "assertion": "object containing the exact assertion id, passed=true, and non-null equal expected/observed values, except the one exact approved waiver which must retain passed=false and unequal observed reality",
      "screenshot": "PNG path and lowercase SHA-256 beneath the candidate evidence root"
    },
    "approved_release_waiver": {
      "case_id": "cross_method:accessibility:actual Windows 200 percent scaling",
      "status": "waived",
      "waiver_authority": "product_owner",
      "waiver_date": "2026-08-22",
      "reason": "product owner explicitly authorized ignoring the 200 percent scaling requirement",
      "expected": { "effective_dpi": 192, "device_pixel_ratio": 2, "clean_profile": true, "forced_scale_argument_present": false },
      "all_other_cases_must_pass": true
    },
    "trust_rule": "A driver report is accepted only when its path and SHA-256 are bound by one exact portable or installed outcome in the passing source-stage candidate report.",
    "anti_reuse_rule": "Each case must use a unique source-report JSON pointer, screenshot member and screenshot SHA-256, receipt member and receipt SHA-256. A source report may support several cases only through distinct observed pointers.",
    "pending_rule": "Absence of one exact case observation remains missing_concrete_driver and makes collection fail; the collector never creates a passing placeholder."
  },
  "publication_contract": {
    "hash_algorithm": "sha256",
    "ordered_case_id_set_sha256": "98ed24bc3d4453cec21768b3c084c916c88acfb831baefbd737d01749d3e105f",
    "screenshot_format": "png",

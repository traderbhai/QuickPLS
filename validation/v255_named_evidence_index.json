    "named_case_manifest_suite_id": "quickpls_v255_named_case_manifest_v1",
    "named_case_manifest_partition_rule": "supplied_by_fixed_drivers, executable cases, and pending_cases form one duplicate-free exact partition of all 55 IDs",
    "operation_by_group": {
      "imports": "import_dataset",
      "exports": "export_result",
      "persistence": "exercise_persistence",
      "accessibility": "exercise_accessibility",
      "observability": "capture_observability_state",
      "packaged": "verify_packaged_candidate",
      "specialized_result_evidence": "calculate_and_open_specialized_result"
    },
    "candidate_selection": {
      "default": "portable",
      "overrides": {
        "cross_method:packaged:installed candidate": "installed"
      }
    },
    "assertion_id_rule": "<operation>:<exact case id>",
    "trusted_driver_suites": [
      { "schema_version": 1, "suite_id": "quickpls_v255_live_calculation_lifecycle_smoke_v1" },
      { "schema_version": 2, "suite_id": "quickpls_v255_method_evidence_crawler_v2" },

        "helper_completion": {
          "type": "object", "required": ["event", "passed", "phase", "targetPath", "mainWindow", "dialog", "boundControls", "saveSubmission", "bundle", "transport"],
          "properties": {
            "event": { "const": "complete" },
            "passed": { "const": true },
            "phase": { "const": "diagnostic_zip_creation_and_readback" },
            "boundControls": { "const": { "filenameEditControlId": 1001, "saveButtonControlId": 1 } },
            "bundle": { "$ref": "#/$defs/helperBundle" },
            "transport": {
              "type": "object", "required": ["exitCode", "signal", "stderr", "events", "protocolErrors"],
              "properties": {
                "exitCode": { "const": 0 }, "signal": { "type": "null" }, "stderr": { "const": "" },
                "events": { "type": "array", "minItems": 2 }, "protocolErrors": { "type": "array", "maxItems": 0 }

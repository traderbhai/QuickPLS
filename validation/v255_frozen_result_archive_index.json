  "reusable_source_inventory": "validation/v255_reusable_archive_inventory.json",
  "reuse_rule": "Do not rerun a scientific engine solely to recreate an unchanged Result screen. Rerun when calculation configuration transfer, lifecycle, routing, persistence, or a changed presentation is being tested.",
  "verified_evidence_contract": {
    "covers": "Non-empty array of declared representative_results. The union across one method's evidence[] must exactly equal its representative_results, with no undeclared family.",
    "cover_assertions": "Exactly one assertion per covers entry. Each assertion names the family, one observed_results_labels source (navigation, visible_headings, or visible_result_table_ids), exact or contains matching, and a non-empty value actually observed by the current frozen-archive crawler.",
    "archive": { "required": ["member", "sha256"] },
    "screenshot": { "required": ["member", "sha256"] },
    "receipt": { "required": ["member", "sha256", "method_kind_json_pointer", "canonical_result_id_json_pointer"] },
    "identity": { "required": ["canonical_result_id", "method_kind"] },
    "hash_algorithm": "sha256",
    "binding_rule": "The parsed receipt must be a verified-current-UI-capture receipt from quickpls_v255_frozen_archive_reopen_crawler_v1. Its selected method/result identity, archive and screenshot hashes, and every covers family must be bound to labels or table IDs observed from the current Results DOM."
  },

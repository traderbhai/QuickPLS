{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickpls.local/schemas/cbsem_exact_case_bootstrap_studentized_phase1b_case_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "case", "manifest_sha256", "status", "acceptance_reasons", "probe", "warmup_runs", "measured_runs", "aggregates", "dimensions", "scientific_result_sha256", "ledger", "runtime_acceptance", "cancellation", "qualification_boundary"],
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted_resource_candidate_evidence" } }, "required": ["status"] },
      "then": { "properties": { "acceptance_reasons": { "maxItems": 0 }, "dimensions": { "$ref": "#/$defs/dimensions" } } },
      "else": { "properties": { "acceptance_reasons": { "minItems": 1 } } }
    },
    {
      "if": {
        "allOf": [
          { "properties": { "status": { "const": "accepted_resource_candidate_evidence" } }, "required": ["status"] },
          { "properties": { "case": { "properties": { "mode": { "enum": ["resource", "stability"] } }, "required": ["mode"] } }, "required": ["case"] }
        ]
      },
      "then": { "properties": { "scientific_result_sha256": { "$ref": "#/$defs/sha256" }, "ledger": { "$ref": "#/$defs/ledger" }, "runtime_acceptance": { "type": "object" } } }
    }
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "cbsem_exact_case_bootstrap_studentized_phase1b_case_v1" },
    "case": {
      "enum": [
        { "case_id": "resource_n180_v9_p18_d18_b5000_w12_seed19001", "order": 1, "mode": "resource", "replicates": 5000, "workers": 12, "seed": 19001, "cancel_after": null, "maximum_single_run_elapsed_seconds": 38.149020597338676, "maximum_p95_elapsed_seconds": 38.149020597338676 },
        { "case_id": "stability_n180_v9_p18_d18_b5000_w12_seed19002", "order": 2, "mode": "stability", "replicates": 5000, "workers": 12, "seed": 19002, "cancel_after": null, "maximum_single_run_elapsed_seconds": 38.149020597338676, "maximum_p95_elapsed_seconds": null },
        { "case_id": "resource_n180_v9_p18_d18_b10000_w12_seed29001", "order": 3, "mode": "resource", "replicates": 10000, "workers": 12, "seed": 29001, "cancel_after": null, "maximum_single_run_elapsed_seconds": 76.29804119467735, "maximum_p95_elapsed_seconds": 76.29804119467735 },
        { "case_id": "stability_n180_v9_p18_d18_b10000_w12_seed29002", "order": 4, "mode": "stability", "replicates": 10000, "workers": 12, "seed": 29002, "cancel_after": null, "maximum_single_run_elapsed_seconds": 76.29804119467735, "maximum_p95_elapsed_seconds": null },
        { "case_id": "cancellation_n180_v9_p18_d18_b10000_w12_seed39001", "order": 5, "mode": "cancellation", "replicates": 10000, "workers": 12, "seed": 39001, "cancel_after": 10, "maximum_single_run_elapsed_seconds": null, "maximum_p95_elapsed_seconds": null }
      ]
    },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "status": { "enum": ["accepted_resource_candidate_evidence", "rejected"] },
    "acceptance_reasons": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "probe": { "type": ["object", "null"] },
    "warmup_runs": { "type": "array", "items": { "type": "object" } },
    "measured_runs": { "type": "array", "items": { "type": "object" } },
    "aggregates": { "type": ["object", "null"] },
    "dimensions": { "anyOf": [{ "$ref": "#/$defs/dimensions" }, { "type": "null" }] },
    "scientific_result_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "ledger": { "anyOf": [{ "$ref": "#/$defs/ledger" }, { "type": "null" }] },
    "runtime_acceptance": { "type": ["object", "null"] },
    "cancellation": { "type": ["object", "null"] },
    "qualification_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "missing_evidence"],
      "properties": {
        "status": { "const": "blocked_not_product_qualification" },
        "missing_evidence": { "const": ["authoritative_canonical_v11_bytes", "authoritative_text_export_v11_bytes", "coverage_and_failure_rate_simulation", "broader_dimension_and_model_axes", "package_and_integration_gates"] }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_complete_cases", "v_observed_variables", "p_free_parameter_rows", "d_optimizer_dimensions"],
      "properties": {
        "n_complete_cases": { "const": 180 },
        "v_observed_variables": { "const": 9 },
        "p_free_parameter_rows": { "const": 18 },
        "d_optimizer_dimensions": { "const": 18 }
      }
    },
    "point_failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicate_index", "kind", "message", "sampling_positions_sha256", "sample_indices_sha256"],
      "properties": {
        "replicate_index": { "type": "integer", "minimum": 0 },
        "kind": { "enum": ["moment_matrix_not_positive_definite", "non_convergence", "inadmissible_solution", "numerical_failure"] },
        "message": { "type": "string", "minLength": 1 },
        "sampling_positions_sha256": { "$ref": "#/$defs/sha256" },
        "sample_indices_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "se_unavailable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replicate_index", "reason"],
      "properties": {
        "replicate_index": { "type": "integer", "minimum": 0 },
        "reason": { "enum": ["singular_information", "information_not_positive_definite", "invalid_information_variance_or_standard_error", "derivative_unavailable", "numerical_information_failure"] }
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["validation_status", "requested_replicates", "attempted_refits", "point_successes", "point_failures_count", "studentized_usable_refits", "standard_error_unavailable_count", "minimum_usable_replicates", "retry_policy", "max_attempts_per_replicate", "base_inference_status", "studentized_inference_status", "point_partition_complete", "standard_error_partition_complete", "point_failure_counts_by_kind", "standard_error_unavailable_counts_by_reason", "point_failures", "standard_error_unavailable", "replicate_indices_digest_method", "successful_replicate_indices_sha256", "standard_error_available_replicate_indices_sha256", "total_studentized_unusable", "total_studentized_unusable_fraction", "one_sided_bound_method", "one_sided_confidence_level", "one_sided_95_percent_upper_bound", "upper_bound_threshold"],
      "properties": {
        "validation_status": { "const": "exact_partition_and_typed_outcomes_validated" },
        "requested_replicates": { "enum": [5000, 10000] },
        "attempted_refits": { "enum": [5000, 10000] },
        "point_successes": { "type": "integer", "minimum": 0 },
        "point_failures_count": { "type": "integer", "minimum": 0 },
        "studentized_usable_refits": { "type": "integer", "minimum": 0 },
        "standard_error_unavailable_count": { "type": "integer", "minimum": 0 },
        "minimum_usable_replicates": { "enum": [4500, 9000] },
        "retry_policy": { "const": "no_retry_fixed_preplanned_primary_draws_v1" },
        "max_attempts_per_replicate": { "const": 1 },
        "base_inference_status": { "enum": ["available", "unavailable"] },
        "studentized_inference_status": { "enum": ["available", "unavailable"] },
        "point_partition_complete": { "const": true },
        "standard_error_partition_complete": { "const": true },
        "point_failure_counts_by_kind": {
          "type": "object",
          "additionalProperties": false,
          "required": ["moment_matrix_not_positive_definite", "non_convergence", "inadmissible_solution", "numerical_failure"],
          "properties": {
            "moment_matrix_not_positive_definite": { "type": "integer", "minimum": 0 },
            "non_convergence": { "type": "integer", "minimum": 0 },
            "inadmissible_solution": { "type": "integer", "minimum": 0 },
            "numerical_failure": { "type": "integer", "minimum": 0 }
          }
        },
        "standard_error_unavailable_counts_by_reason": {
          "type": "object",
          "additionalProperties": false,
          "required": ["singular_information", "information_not_positive_definite", "invalid_information_variance_or_standard_error", "derivative_unavailable", "numerical_information_failure"],
          "properties": {
            "singular_information": { "type": "integer", "minimum": 0 },
            "information_not_positive_definite": { "type": "integer", "minimum": 0 },
            "invalid_information_variance_or_standard_error": { "type": "integer", "minimum": 0 },
            "derivative_unavailable": { "type": "integer", "minimum": 0 },
            "numerical_information_failure": { "type": "integer", "minimum": 0 }
          }
        },
        "point_failures": { "type": "array", "items": { "$ref": "#/$defs/point_failure" } },
        "standard_error_unavailable": { "type": "array", "items": { "$ref": "#/$defs/se_unavailable" } },
        "replicate_indices_digest_method": { "const": "sha256_canonical_json_ordered_u32_array_v1" },
        "successful_replicate_indices_sha256": { "$ref": "#/$defs/sha256" },
        "standard_error_available_replicate_indices_sha256": { "$ref": "#/$defs/sha256" },
        "total_studentized_unusable": { "type": "integer", "minimum": 0 },
        "total_studentized_unusable_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "one_sided_bound_method": { "const": "clopper_pearson_beta_quantile_one_sided_v1" },
        "one_sided_confidence_level": { "const": 0.95 },
        "one_sided_95_percent_upper_bound": { "type": "number", "minimum": 0, "maximum": 1 },
        "upper_bound_threshold": { "const": 0.1 }
      }
    }
  }
}

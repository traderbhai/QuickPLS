{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickpls.local/schemas/cbsem_exact_case_bootstrap_studentized_phase1_report_v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "run_id", "status", "manifest_path", "manifest_sha256", "phase0_report_path", "phase0_report_sha256", "binary_path", "binary_sha256", "physical_memory_bytes", "hardware", "case_receipts", "acceptance_summary", "cap_decision"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "const": "cbsem_exact_case_bootstrap_studentized_phase1_report_v1" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "status": { "enum": ["phase1_applied_evidence_passed_product_cap_blocked_missing_optimizer_dimension", "phase1_applied_evidence_failed_product_cap_blocked"] },
    "manifest_path": { "type": "string", "minLength": 1 },
    "manifest_sha256": { "$ref": "#/$defs/sha256" },
    "phase0_report_path": { "type": "string", "minLength": 1 },
    "phase0_report_sha256": { "$ref": "#/$defs/sha256" },
    "binary_path": { "type": "string", "minLength": 1 },
    "binary_sha256": { "$ref": "#/$defs/sha256" },
    "physical_memory_bytes": { "type": "integer", "minimum": 0 },
    "hardware": { "type": "object" },
    "case_receipts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "path", "sha256", "status", "acceptance_reasons"],
        "properties": {
          "case_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "status": { "enum": ["accepted", "rejected", "blocked_by_dependency"] },
          "acceptance_reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        }
      }
    },
    "acceptance_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons", "runtime_safety_factor", "optimizer_dimension_status"],
      "properties": {
        "status": { "enum": ["all_predeclared_cases_accepted", "one_or_more_predeclared_cases_not_accepted"] },
        "reasons": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "runtime_safety_factor": { "const": 2.0 },
        "optimizer_dimension_status": { "const": "unavailable_product_cap_blocked" }
      }
    },
    "cap_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "const": "blocked_missing_optimizer_dimension" },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}

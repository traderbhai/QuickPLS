      "const": 2
    },
    "kind": {
      "const": "cbsem_exact_two_group_configural_metric_engine_reference_manifest_v2"
    },
    "status": {
      "const": "predeclared_reproducible_engine_reference_program_product_qualification_blocked"
    },
    "source_bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_binding"
      },
      "minItems": 9,
      "maxItems": 9

          "const": "frozen_xorshift32_box_muller_raw_rows_v1"
        },
        "seed": {
          "const": 539363350
        },
        "factor_correlation": {
          "const": 0.35
        },
        "marker_loadings": {
          "const": {
            "x1": 1,
            "y1": 1
          }
        },
        "nonmarker_loadings": {
          "const": {
            "A": {
              "x2": 0.82,
              "x3": 0.71,
              "y2": 0.78,
              "y3": 0.66
            },
            "B": {
              "x2": 0.82,
              "x3": 0.38,
              "y2": 0.78,
              "y3": 0.66
            }
          }
        },
        "residual_standard_deviations": {
          "const": {
            "x1": 0.55,
            "x2": 0.6,
            "x3": 0.65,
            "y1": 0.58,
            "y2": 0.62,
            "y3": 0.68
          }
        },
        "deliberate_noninvariance": {
          "const": "group_B_x3_loading_0.38_vs_group_A_0.71"
        }
      }

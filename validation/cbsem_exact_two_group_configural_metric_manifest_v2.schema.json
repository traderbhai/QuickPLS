        "metric_free_dimensions": {
          "const": 22
        },
        "metric_degrees_of_freedom": {
          "const": 20
        },
        "delta_degrees_of_freedom": {
          "const": 4
        }
      }
    },
    "scientific_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "estimator",
        "objective",
        "covariance_denominator",
        "missing_data",
        "mean_structure",
        "fixed_x",
        "identification",
        "metric_constraint",

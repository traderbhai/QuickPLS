      "properties": {
        "primary": {
          "const": "cb5e2a01-0000-0000-0000-000000000001"
        },
        "label_swap": {
          "const": "cb5e2a01-0000-0000-0000-000000000002"
        }
      }
    },
    "supersedes": {
      "type": "object",

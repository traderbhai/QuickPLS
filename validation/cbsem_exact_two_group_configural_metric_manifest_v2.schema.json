        "sha256": {
          "const": "bc430dbd7907d39ed95f278ce8cfa2e8cf28478f1a3486226bcad2192350b919"
        },
        "disposition": {
          "const": "rejected_nondeterministic_import_dataset_identity"
        },
        "reason": {
          "const": "import_generated_random_dataset_uuids_changed_full_engine_json_between_executions"
        }
      }

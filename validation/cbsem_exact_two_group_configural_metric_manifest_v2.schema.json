    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "moment_absolute",
        "parameter_absolute",
        "implied_covariance_absolute",
        "objective_absolute",
        "chi_square_absolute",
        "p_value_absolute",
        "label_swap_absolute",
        "lavaan_chi_square_absolute"
      ],
      "properties": {
        "moment_absolute": {
          "const": 1e-12
        },
        "parameter_absolute": {
          "const": 0.0001
        },
        "implied_covariance_absolute": {
          "const": 0.0001
        },
        "objective_absolute": {
          "const": 1e-7
        },
        "chi_square_absolute": {
          "const": 0.000001
        },
        "p_value_absolute": {
          "const": 1e-9
        },
        "label_swap_absolute": {
          "const": 1e-7
        },
        "lavaan_chi_square_absolute": {
          "const": 0.001

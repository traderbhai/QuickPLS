    "fixture_contract": {
      "$ref": "#/$defs/fixture_contract"
    },
    "scientific_contract": {
      "$ref": "#/$defs/scientific_contract"
    },
    "acceptance_tolerances": {
      "$ref": "#/$defs/tolerances"
    },
    "execution_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "append_only_report",
        "explicit_execute_required",
        "engine_timeout_seconds",
        "lavaan_unavailable_policy",
        "release_binary_path"

        "lavaan_contract": {
          "const": {
            "estimator": "ML",
            "missing": "listwise",
            "meanstructure": false,
            "fixed_x": false,
            "std_lv": false,
            "marker_identification": true,
            "configural_group_equal": [],
            "metric_group_equal": [
              "loadings"
            ]
          }
        }
      }

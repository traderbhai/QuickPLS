        "explicit_execute_required": {
          "const": true
        },
        "engine_timeout_seconds": {
          "const": 120
        },
        "lavaan_unavailable_policy": {
          "const": "allowed_for_engine_reference_only_and_blocks_external_cross_implementation_claim"
        },
        "release_binary_path": {
          "const": "target/release/examples/cbsem_exact_two_group_configural_metric_validation.exe"
        }
      }
    },
    "qualification_boundary": {
      "$ref": "#/$defs/qualification_boundary"
    },
    "supersedes": {
      "$ref": "#/$defs/supersedes"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": [
            "primary_raw_fixture",
            "label_swap_raw_fixture",
            "independent_python_oracle",
            "independent_lavaan_script",
            "rust_validation_example",
            "quarantined_engine_source",
            "manifest_schema",
            "report_schema",
            "release_validation_binary"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "dgp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generation",

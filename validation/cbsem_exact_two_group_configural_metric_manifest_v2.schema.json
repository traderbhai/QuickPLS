        "lavaan_contract"
      ],
      "properties": {
        "model": {
          "const": "two_correlated_factors_three_reflective_indicators_each"
        },
        "estimator": {
          "const": "ordinary_maximum_likelihood"
        },
        "objective": {
          "const": "sum_over_groups_Ng_times_Fml_group_with_total_objective_divided_by_total_N"
        },
        "covariance_denominator": {
          "const": "maximum_likelihood_n"
        },
        "missing_data": {
          "const": "listwise_deletion"
        },
        "mean_structure": {
          "const": false
        },
        "fixed_x": {
          "const": false
        },
        "identification": {
          "const": "first_loading_per_factor_fixed_to_one_in_each_group"
        },
        "metric_constraint": {
          "const": "four_corresponding_nonmarker_loadings_equal_across_groups"
        },
        "expected_dimensions": {
          "$ref": "#/$defs/dimensions"

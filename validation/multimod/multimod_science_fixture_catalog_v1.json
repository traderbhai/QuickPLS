    "label_alignment_decision_cells": [
      {"k": 3, "cases": ["nonidentity_mutual_majority", "ambiguous", "unique_nonmajority"], "exhaustive_mappings": 6},
      {"k": 4, "cases": ["nonidentity_mutual_majority", "ambiguous", "unique_nonmajority"], "exhaustive_mappings": 24},
      {"k": 5, "cases": ["nonidentity_mutual_majority", "ambiguous", "unique_nonmajority"], "exhaustive_mappings": 120}
    ],
    "common_metric_rule": "Passed gates publish pooled-common-metric parameters and contrasts; failed gates retain segment-local descriptive estimates and suppress contrasts.",
    "independent_evidence": {
      "fimix": "Pooled standardized equation design/outcomes are retained for independent log-sum-exp likelihood and posterior reconstruction.",
      "pls_pos": "Final segment observed/fitted outcome scores are retained for independent endogenous R-squared and unweighted objective reconstruction.",
      "common_metric": "MICOM permutation compositional-correlation series are retained for independent Type-7 Step-2 reconstruction."
    },
    "failure_boundary_evidence": {
      "raw_scenarios": ["rank_deficient", "variance_collapse", "rare_class_below_five_percent"],
      "kernel_test_filter": "fimix_failure_boundary_",
      "typed_codes": ["likelihood_decrease", "non_finite", "collapsed_class", "variance_collapse", "rank_deficient"],
      "fault_injection_api_shipped": false
    }
  },

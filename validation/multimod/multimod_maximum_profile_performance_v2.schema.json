{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qpls://validation/multimod/maximum-profile-performance/v2",
  "title": "QuickPLS MultiMod maximum-profile performance evidence V2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "passed", "seed", "source_commit",
    "measurement_contract", "metrics_fail_closed_when_unavailable",
    "one_release_cargo_build", "release_build", "cargo_run_invocations",
    "direct_binary_execution_after_build", "per_atomic_process_timeout_seconds",
    "internal_timeout_seconds", "execution_deadline_seconds",
    "publication_reserve_seconds", "final_publication_cutoff_enforced",
    "predeclared_budgets", "workloads", "execution_topology_path",
    "execution_topology_sha256", "execution_topology",
    "production_output_verification", "production_output_verification_path",
    "production_output_verification_sha256", "source_digests",
    "sidecar_size_metrics", "output_total_bytes", "generated_at_utc"
  ],
  "properties": {
    "schema_version": { "const": 2 },
    "report_id": { "const": "qpls.v256.multimod.maximum-profile-performance.v2" },
    "passed": { "const": true },
    "seed": { "const": 42 },
    "source_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "measurement_contract": { "const": "windows_sampled_concurrent_plus_per_process_peak_working_set_v3" },
    "metrics_fail_closed_when_unavailable": { "const": true },
    "one_release_cargo_build": { "const": true },
    "release_build": { "type": "object" },
    "cargo_run_invocations": { "const": 0 },
    "direct_binary_execution_after_build": { "const": true },
    "per_atomic_process_timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 1800 },
    "internal_timeout_seconds": { "const": 6480 },
    "execution_deadline_seconds": { "const": 6360 },
    "publication_reserve_seconds": { "const": 120 },
    "final_publication_cutoff_enforced": { "const": true },
    "predeclared_budgets": { "type": "object" },
    "workloads": { "type": "array", "minItems": 3, "maxItems": 3 },
    "execution_topology_path": { "type": "string", "minLength": 1 },
    "execution_topology_sha256": { "$ref": "#/$defs/sha256" },
    "execution_topology": { "type": "object" },
    "production_output_verification": { "type": "object" },
    "production_output_verification_path": { "type": "string", "minLength": 1 },
    "production_output_verification_sha256": { "$ref": "#/$defs/sha256" },
    "source_digests": { "type": "array", "minItems": 1 },
    "sidecar_size_metrics": { "type": "object" },
    "output_total_bytes": { "type": "integer", "minimum": 1 },
    "generated_at_utc": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}

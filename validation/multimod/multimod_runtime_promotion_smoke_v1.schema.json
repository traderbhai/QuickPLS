{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quickpls.local/schemas/multimod-runtime-promotion-smoke-v1.schema.json",
  "title": "QuickPLS MultiMod packaged runtime promotion smoke V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_kind",
    "lane",
    "candidate_commit_sha",
    "candidate_version",
    "plan_sha256",
    "binding_sha256",
    "authority_document_sha256",
    "authority_binding_sha256",
    "manifest_set_sha256",
    "package_receipt_sha256",
    "executable_path",
    "executable_sha256",
    "offline",
    "console_window_absent",
    "qualification_state",
    "unqualified_authority_fails_closed",
    "post_evidence_source_change_required",
    "qualification_coverage_complete",
    "qualification_harness_contract",
    "unmerged_review_candidate",
    "later_harness_disabled_rebuild_covered",
    "production_workflow_evidence_path",
    "production_workflow_evidence_sha256",
    "families",
    "cancellation_recovery_verified",
    "isolated_nsis_install_verified",
    "uninstall_cleanup_verified",
    "timing_provenance",
    "cleanup_provenance"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "receipt_kind": { "const": "qpls_multimod_runtime_promotion_smoke_v1" },
    "lane": { "enum": ["installed", "portable"] },
    "candidate_commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "candidate_version": { "const": "2.56.0" },
    "plan_sha256": { "$ref": "#/$defs/sha256" },
    "binding_sha256": { "$ref": "#/$defs/sha256" },
    "authority_document_sha256": { "$ref": "#/$defs/sha256" },
    "authority_binding_sha256": { "$ref": "#/$defs/sha256" },
    "manifest_set_sha256": { "$ref": "#/$defs/sha256" },
    "package_receipt_sha256": { "$ref": "#/$defs/sha256" },
    "executable_path": { "type": "string", "minLength": 1 },
    "executable_sha256": { "$ref": "#/$defs/sha256" },
    "offline": { "const": true },
    "console_window_absent": { "const": true },
    "qualification_state": { "const": "release_qualified_candidate" },
    "unqualified_authority_fails_closed": { "const": true },
    "post_evidence_source_change_required": { "const": false },
    "qualification_coverage_complete": { "const": true },
    "qualification_harness_contract": { "const": "qpls.v256.multimod.build-only-packaged-qualification-harness.v1" },
    "unmerged_review_candidate": { "const": true },
    "later_harness_disabled_rebuild_covered": { "const": false },
    "production_workflow_evidence_path": { "type": "string", "minLength": 1 },
    "production_workflow_evidence_sha256": { "$ref": "#/$defs/sha256" },
    "families": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_id",
          "valid_run_completed",
          "result_identity_verified",
          "archive_reopened",
          "semantic_export_readback",
          "sidecar_integrity_verified"
        ],
        "properties": {
          "family_id": {
            "enum": [
              "qpls.multimod.mga_multigroup_v1",
              "qpls.multimod.pls_heterogeneity_v2",
              "qpls.multimod.general_sem_conditional_process_v2",
              "qpls.multimod.interventional_causal_mediation_v1"
            ]
          },
          "valid_run_completed": { "const": true },
          "result_identity_verified": { "const": true },
          "archive_reopened": { "const": true },
          "semantic_export_readback": { "const": true },
          "sidecar_integrity_verified": { "const": true }
        }
      }
    },
    "cancellation_recovery_verified": { "const": true },
    "isolated_nsis_install_verified": { "type": "boolean" },
    "uninstall_cleanup_verified": { "type": "boolean" },
    "timing_provenance": { "$ref": "#/$defs/timingProvenance" },
    "cleanup_provenance": { "$ref": "#/$defs/cleanupProvenance" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "timingProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "wrapper_started_at_utc",
        "driver_started_at_utc",
        "driver_exit_epoch_ms",
        "scientific_deadline_epoch_ms",
        "wrapper_maximum_seconds",
        "scientific_maximum_seconds",
        "minimum_cleanup_reserve_seconds",
        "finalization_reserve_seconds",
        "poll_deadlines_clamped_to_family_and_driver",
        "late_exit_rejection_enabled",
        "wrapper_elapsed_milliseconds"
      ],
      "properties": {
        "contract_id": { "const": "qpls.v256.multimod.packaged-hard-time-budget.v1" },
        "wrapper_started_at_utc": { "type": "string", "minLength": 1 },
        "driver_started_at_utc": { "type": "string", "minLength": 1 },
        "driver_exit_epoch_ms": { "type": "integer", "minimum": 1 },
        "scientific_deadline_epoch_ms": { "type": "integer", "minimum": 1 },
        "wrapper_maximum_seconds": { "const": 6480 },
        "scientific_maximum_seconds": { "const": 5340 },
        "minimum_cleanup_reserve_seconds": { "const": 1020 },
        "finalization_reserve_seconds": { "const": 120 },
        "poll_deadlines_clamped_to_family_and_driver": { "const": true },
        "late_exit_rejection_enabled": { "const": true },
        "wrapper_elapsed_milliseconds": { "type": "integer", "minimum": 0, "maximum": 6480000 }
      }
    },
    "cleanupProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_id",
        "cleanup_started_at_utc",
        "cleanup_completed_at_utc",
        "cleanup_elapsed_milliseconds",
        "node_root_started",
        "node_pid",
        "node_process_tree_supervised",
        "node_forced_termination",
        "node_process_tree_terminated",
        "exact_root_started",
        "exact_root_terminated",
        "candidate_process_tree_termination_requested",
        "active_work_cancelled_via_candidate_termination",
        "endpoint_closed",
        "candidate_termination_before_uninstall",
        "exact_nsis_uninstall_attempted",
        "nsis_uninstall_exit_code",
        "install_root_removed",
        "registration_removed",
        "cleanup_sequence"
      ],
      "properties": {
        "contract_id": { "const": "qpls.v256.multimod.packaged-process-cleanup.v1" },
        "cleanup_started_at_utc": { "type": "string", "minLength": 1 },
        "cleanup_completed_at_utc": { "type": "string", "minLength": 1 },
        "cleanup_elapsed_milliseconds": { "type": "integer", "minimum": 0, "maximum": 6480000 },
        "node_root_started": { "const": true },
        "node_pid": { "type": "integer", "minimum": 1 },
        "node_process_tree_supervised": { "const": true },
        "node_forced_termination": { "type": "boolean" },
        "node_process_tree_terminated": { "const": true },
        "exact_root_started": { "const": true },
        "exact_root_terminated": { "const": true },
        "candidate_process_tree_termination_requested": { "const": true },
        "active_work_cancelled_via_candidate_termination": { "const": true },
        "endpoint_closed": { "const": true },
        "candidate_termination_before_uninstall": { "const": true },
        "exact_nsis_uninstall_attempted": { "type": "boolean" },
        "nsis_uninstall_exit_code": { "type": ["integer", "null"] },
        "install_root_removed": { "const": true },
        "registration_removed": { "const": true },
        "cleanup_sequence": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
